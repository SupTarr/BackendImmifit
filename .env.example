# Server Configuration
PORT=4001

# MongoDB Configuration
# Example: mongodb://localhost:27017/immifit_db
# Or for Atlas: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string
MONGO_USER= # Optional: Your MongoDB username (if not in URI)
MONGO_PASSWORD= # Optional: Your MongoDB password (if not in URI)
MONGO_DATABASE=immifit_db # Your MongoDB database name

# JWT Secrets (must be strong, random strings)
ACCESS_TOKEN_SECRET=your_strong_access_token_secret_here
REFRESH_TOKEN_SECRET=your_strong_refresh_token_secret_here

# Cloudinary Configuration (if used, as per README)
# Ensure these are consistent with how Cloudinary is configured and used in the project.
# The README lists these, so they should be in the example.
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# Deployment (Set to true if deploying to Vercel, as per README)
IS_VERCEL=false
